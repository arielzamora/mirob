# Copiá este archivo a backend/.env y completá los valores.
# backend/.env está ignorado por git: NUNCA subas valores reales.
# No hay API keys: la autenticación es con Entra ID (`az login`, rol "Foundry User" sobre el proyecto; antes se llamaba "Azure AI User").

# Clave del admin (POST /admin/content, header X-API-Key). SOLUCIÓN TEMPORAL.
# Sin esta variable el admin queda deshabilitado (responde 503). Generá una con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
MIROB_ADMIN_API_KEY=<clave-larga-y-aleatoria>

# URL del proyecto de Foundry (portal -> tu proyecto -> Overview -> endpoint).
FOUNDRY_ENDPOINT=https://<tu-recurso>.services.ai.azure.com/api/projects/<tu-proyecto>

# Nombre de TU deployment de chat (el nombre que elegiste en el portal, no el del modelo).
# MiRob está pensado para un modelo chico y barato. gpt-4o-mini y gpt-4.1-mini están "Deprecated" y una
# suscripción nueva ya no puede desplegarlos: usá gpt-5.4-nano (o gpt-5.4-mini), tipo de deployment
# GlobalStandard (pago por token). La salida se limita a 250 tokens.
FOUNDRY_CHAT_DEPLOYMENT=<nombre-del-deployment-de-chat>

# --- Salida a producción (ver docs/adr/0003 y 0004) ---

# Orígenes donde está hospedado el FRONT, separados por comas (CORS). Sin barra final ni comodines.
# Los de desarrollo (localhost:5173 y :3000) siempre están permitidos.
# MIROB_CORS_ORIGINS=https://mirob.example.com

# URL del front. La usa GET /embed/{tenant_id} para armar el iframe que embebe el sitio del cliente.
# MIROB_FRONTEND_URL=https://mirob.example.com

# Poné 1 SOLO si la API corre detrás de un proxy de confianza (Azure Container Apps): entonces la
# IP del cliente sale del último valor de X-Forwarded-For. Sin proxy, dejalo sin definir.
# MIROB_TRUST_PROXY=1

# Límites (valores por defecto entre paréntesis). Enteros positivos.
# MIROB_RATE_CHAT_PER_MINUTE=20     # pedidos de chat por IP por minuto
# MIROB_RATE_FOUNDRY_PER_HOUR=30    # llamadas al LLM por IP por hora
# MIROB_RATE_ADMIN_PER_MINUTE=10    # pedidos al admin por IP por minuto
# MIROB_DAILY_TOKEN_CAP=200000      # tokens por día (UTC) entre todos los tenants
# MIROB_RATE_ACCESS_PER_MINUTE=10   # canjes de access key por IP por minuto
# MIROB_RATE_KEY_PER_MINUTE=10      # preguntas por minuto de una misma access key

# --- Access keys de reclutadores (ver docs/adr/0010) ---

# Secreto con el que se firman las sesiones (mínimo 32 caracteres). Sin él, los tenants con
# "acceso": "access_key" en su tenant.json responden 503 (no quedan abiertos) y los públicos siguen igual.
# Generá uno con: python -c "import secrets; print(secrets.token_urlsafe(48))"
# MIROB_SESSION_SECRET=<secreto-largo-y-aleatorio>

# Duración de una sesión en minutos (por defecto 120). Nunca supera el vencimiento de la key.
# MIROB_SESSION_MINUTES=120

# Opcionales para modelos de razonamiento (familia gpt-5). Si no los definís, NO se envían.
# Esos modelos cuentan los tokens de "pensar" dentro del tope de salida (250): con un esfuerzo alto
# pueden gastarlo todo y devolver la respuesta vacía. Si pasa, bajá el esfuerzo.
# Valores: none, minimal, low, medium, high, xhigh, max (cada modelo acepta solo algunos).
# FOUNDRY_REASONING_EFFORT=minimal
# `temperature` solo la aceptan los modelos sin razonamiento (o con esfuerzo "none"). Número de 0 a 2.
# FOUNDRY_TEMPERATURE=0.2

# Opcional: deployment de embeddings. Todavía no se usa (Etapa 2.1).
# FOUNDRY_EMBEDDINGS_DEPLOYMENT=<nombre-del-deployment-de-embeddings>
